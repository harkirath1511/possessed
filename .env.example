# Copy this file to .env in this directory. Never commit .env.
# Browserbase dashboard: https://www.browserbase.com/overview
BROWSERBASE_API_KEY=
# Optional if required by your Browserbase account.
BROWSERBASE_PROJECT_ID=

# Ollama is the default model provider. Set the exact installed Gemma tag.
OLLAMA_BASE_URL=http://127.0.0.1:11434
GEMMA_MODEL=gemma3:4b
# Alternatively use a hosted OpenAI-compatible Gemma endpoint.
GEMMA_API_BASE_URL=
GEMMA_API_KEY=
# Paid OpenRouter calls are disabled unless an explicit budget is set.
# The hackathon verification allowance is capped at $0.10 across key usage.
MODEL_BUDGET_USD=0

# Sentry project Settings > Client Keys (DSN).
SENTRY_DSN=

# For a cloud browser, set this to the public URL of this app.
# The local browser uses the app's local URL automatically.
PUBLIC_APP_URL=
PORT=4177

# Optional shared secret for live-run APIs when deploying publicly.
# Configure the same value in the app's Connection settings.
LIVE_RUN_TOKEN=
