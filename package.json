{
  "name": "possessed-archive",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A haunted archive for observing prompt injection in a real browser agent.",
  "scripts": {
    "dev": "node --watch-path=server server/index.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.mjs --production",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run test && npm run build",
    "evaluate": "node scripts/evaluate.mjs"
  },
  "engines": { "node": ">=22.12.0" },
  "dependencies": {
    "@browserbasehq/stagehand": "4.3.0",
    "@sentry/node": "11.10.0",
    "dotenv": "^17.2.3",
    "express": "5.3.0",
    "lucide-react": "^0.468.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "overrides": {
    "zod": "$zod",
    "glob": "14.0.3",
    "minimatch": "11.0.3"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "~5.9.3",
    "vite": "8.3.5"
  }
}
